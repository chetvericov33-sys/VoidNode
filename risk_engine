// Void Node deterministic Risk Engine v1
// Pure module: no network, Redis, Telegram or environment dependencies.
// The sum of factor points is the displayed Risk Score (0..100).

function calculateRiskBreakdown(input) {
    var top=Number(input.top)||0, stable=Number(input.stable)||0, alts=Number(input.alts)||0;
    var weights=Array.isArray(input.weights)?input.weights.map(Number).filter(function(x){return isFinite(x)&&x>0;}).sort(function(a,b){return b-a;}).slice(0,3):[top];
    var meaningful=Number(input.meaningful)||0, complete=input.coverageComplete!==false;
    var targets=input.targets||{BTC:50,USDT:20,ALTS:30};

    // Max weights sum to 100: concentration 50, reserve 15, alts 15, diversification 10, data quality 10.
    // Each factor is monotonic and piecewise linear/threshold based, so every point is auditable.
    var concentrationParts=weights.map(function(w){return {weight:w,points:(w<=20?0:(w<=42?Math.round((w-20)/(42-20)*18):Math.min(50,18+Math.round((w-42)/(85-42)*27))))};}); var concentration=concentrationParts.reduce(function(sum,x){return sum+x.points;},0); concentration=Math.min(50,concentration);
    var reserve=stable>=20?0:Math.min(15,Math.round((20-stable)/20*15));
    var alt=alts<=targets.ALTS?0:Math.min(15,Math.round((alts-targets.ALTS)/(80-targets.ALTS)*15));
    var diversification=meaningful>=5?0:meaningful===4?2:meaningful===3?4:meaningful===2?7:10;
    var data=complete?0:10;

    var items=[
        {key:'concentration',points:concentration,labelRu:'Концентрация',labelEn:'Concentration',subFactors:concentrationParts},
        {key:'reserve',points:reserve,labelRu:'Низкий резерв стейблкоинов',labelEn:'Low stablecoin reserve'},
        {key:'alt_exposure',points:alt,labelRu:'Высокая доля альткоинов',labelEn:'High altcoin exposure'},
        {key:'diversification',points:diversification,labelRu:'Слабая диверсификация',labelEn:'Weak diversification'},
        {key:'data_quality',points:data,labelRu:'Неполные данные',labelEn:'Incomplete data'}
    ];
    var drivers=[];
    items.forEach(function(x){ if(x.points>0) drivers.push(x.key); });
    items.sort(function(a,b){return b.points-a.points;});
    var score=Math.min(100,items.reduce(function(sum,x){return sum+x.points;},0));
    return {score:score,drivers:drivers,breakdown:items};
}

module.exports={calculateRiskBreakdown};
